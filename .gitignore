# ==========================================
# Dependencies
# ==========================================
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
*.env
*.env.local
server/.env
server/.env.*
client/.env
client/.env.*
