!*.env.example
!server/.env.example
!client/.env.example

# ==========================================
# Production & Vite Build Artifacts
# ==========================================
dist/
dist-ssr/
build/
client/dist/
out/
.next/

# ==========================================
# Dynamic Uploads (PDFs, Marksheets, Images)
# ==========================================
server/uploads/*
uploads/*
!server/uploads/.gitkeep
!uploads/.gitkeep

# ==========================================
# Runtime, Logs & Temporary Files
# ==========================================
logs/
*.log
.pids
*.pid
*.seed
*.pid.lock
.temp/
.tmp/
tmp/
temp/

# ==========================================
# Testing & Code Coverage
# ==========================================
coverage/
*.lcov
.nyc_output

# ==========================================
# Editor & IDE Directories
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

